CONFIG_USB_DWC3_SHARP_CUST=y
CONFIG_USB_GSPCA=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
CONFIG_USB_VIDEO_CLASS=y

# Sharp leds
CONFIG_LEDS_SHARP_QPNP_HAPTIC=y
