# CONFIG_RMNET_DATA_DEBUG_PKT is not set
# CONFIG_WIL6210 is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_SERIO is not set
# CONFIG_QPNP_QNOVO is not set
# CONFIG_MMC_TEST is not set
# CONFIG_MSM_QBT1000 is not set
# CONFIG_STM is not set
# CONFIG_F2FS_FS is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_CORESIGHT is not set
# CONFIG_CRYPTO_CRC32 is not set

CONFIG_LOCALVERSION="-using-debug"

# KernelSU
CONFIG_KSU=y
CONFIG_KPROBES=y

CONFIG_BRIDGE_NETFILTER=y
CONFIG_MSM_RDBG=y
CONFIG_DVB_MPQ=y
CONFIG_DVB_MPQ_DEMUX=y
CONFIG_TSPP=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_MSM_11AD=y
CONFIG_QCOM_LLCC_PERFMON=y

# dtbo
#CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Touchscreen
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_v26 is not set
CONFIG_TOUCHSCREEN_SHARP_TPS=y
CONFIG_SHARP_TPS_SY3700_CUSPRJ_2295=y
CONFIG_SHARP_TPS_SY3X00_DEV=y

# NFC
CONFIG_NFC=y
# CONFIG_NFC_NQ is not set
CONFIG_NFC_CXD224X=y
CONFIG_NFC_CXD224X_RST_USE_PMIC=y

# Sharp mmc
CONFIG_SHARP_MMC_SD_BATTLOG=y
CONFIG_SHARP_MMC_SD_DISABLE_CLK_SCALE=y
CONFIG_SHARP_MMC_SD_ECO_MODE=y
CONFIG_SHARP_MMC_SD_ENABLE_ONLY_DDR50=y
CONFIG_SHARP_MMC_SD=y
CONFIG_SHARP_MMC=y

# Sharp pnp
CONFIG_SHARP_PNP_CLOCK_DEBUG=y
CONFIG_SHARP_PNP_CLOCK=y
CONFIG_SHARP_PNP_SLEEP_DEBUG=y
CONFIG_SHARP_PNP_SLEEP_SLEEPLOG=y
CONFIG_SHARP_PNP_SLEEP=y
CONFIG_SHARP_PNP_THERMAL=y
CONFIG_SHARP_PNP=y

# Sharp log
CONFIG_SHARP_SHLOG_LATESTSTACK=y
CONFIG_SHARP_SHLOG_RAMOOPS=y
CONFIG_SHARP_SHLOG_SHOW_ABOOTLOG=y
CONFIG_SHARP_SHLOG_TASKLIST=y
CONFIG_SHARP_SHLOG=y
CONFIG_SHARP_SUPPORT_DLOAD_BOOTPARAM=y

# Sharp panic
CONFIG_SHARP_HANDLE_PANIC=y
CONFIG_SHARP_HANDLE_SURFACE_FLINGER=y
CONFIG_SHARP_PANIC_ON_PWRKEY_TIMEOUT_MS_VS=0
CONFIG_SHARP_PANIC_ON_PWRKEY_TIMEOUT_MS=0
CONFIG_SHARP_PANIC_ON_PWRKEY_TIMEOUT_VS=4
CONFIG_SHARP_PANIC_ON_PWRKEY_TIMEOUT=8
CONFIG_SHARP_PANIC_ON_PWRKEY=y
CONFIG_PANIC_TIMEOUT=1

# Sharp USB
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_ANDROID_SHARP_CUST=y
CONFIG_USB_ANDROID_SHARP_MTP=y
CONFIG_USB_ANDROID_SHARP_SERIALS=y
CONFIG_USB_ANDROID_SHARP_UMS=y
